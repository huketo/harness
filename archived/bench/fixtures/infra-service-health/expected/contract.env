# verify.sh가 참조하는 상수. README-ops.md의 기동 조건과 같은 값이다.
EXPECTED_PORT=18080
EXPECTED_HEALTH_PATH=/healthz
EXPECTED_MAX_RESTARTS=3
STARTUP_TIMEOUT_SECONDS=10
RESTART_TIMEOUT_SECONDS=5
DOWN_WINDOW_SECONDS=3
LOG_FILE=logs/service.log
PID_FILE=logs/service.pid
STDOUT_MARKER="listening on"
STDERR_MARKER="service diagnostics"
