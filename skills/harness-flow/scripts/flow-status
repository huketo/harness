#!/usr/bin/env bash
# flow-status — read-only: what a repository already has on each layer, and which skill comes next.
#   flow-status [repo]     repo defaults to the current directory; prints one `layer<TAB>item<TAB>state<TAB>evidence`
#                          line per check, then `next<TAB><skill><TAB><reason>`. Writes nothing.
# Presence only: it sees that a file or entry exists, not whether it is strong. The order of `next` is the one
# skills/harness-flow/SKILL.md describes.
set -euo pipefail
dir=${1:-.}
[ -d "$dir" ] || { echo "flow-status: $dir is not a directory" >&2; exit 2; }
root=$(git -C "$dir" rev-parse --show-toplevel 2>/dev/null) || { echo "flow-status: $dir is not inside a git repository" >&2; exit 2; }
cd "$root"

row() { printf '%s\t%s\t%s\t%s\n' "$1" "$2" "$3" "${4:--}"; }
first() { for f in "$@"; do [ -e "$f" ] && { printf '%s' "$f"; return 0; }; done; return 1; }
globfirst() { local m; m=$(compgen -G "$1" | head -n 1) && [ -n "$m" ] && printf '%s' "$m"; }

# Tracked source files. Tool configuration (`*.config.*`, dotfiles), documents, and lock files do not count.
sources=$(git ls-files | grep -vE '(^|/)\.[^/]+$|(^|/)[^/]+\.config\.[^/]+$' |
  grep -cE '\.(ts|tsx|js|jsx|mjs|cjs|py|go|rs|java|kt|rb|php|cs|swift|c|cc|cpp|h|hpp|sh)$' || true)
if [ "$sources" -eq 0 ]; then row code sources none "no tracked source file"; else row code sources "$sources" "git ls-files"; fi

# One check command that runs everything, the same locally and in CI.
check=
if [ -f mise.toml ] && grep -qE '^\[tasks\.check\]' mise.toml; then check="mise.toml [tasks.check]"
elif [ -f package.json ] && node -e 'const c = JSON.parse(require("fs").readFileSync("package.json", "utf8")).scripts?.check; process.exit(typeof c === "string" && c.trim() ? 0 : 1)' 2>/dev/null; then check="package.json scripts.check"
elif m=$(first Makefile makefile GNUmakefile) && grep -qE '^check:' "$m"; then check="$m check:"
elif m=$(first justfile Justfile .justfile) && grep -qE '^check' "$m"; then check="$m check"
fi
if [ -n "$check" ]; then row static check-command present "$check"; else row static check-command missing; fi

lint=$(first eslint.config.js eslint.config.mjs eslint.config.cjs eslint.config.ts .eslintrc.js .eslintrc.cjs .eslintrc.json .eslintrc.yml .eslintrc biome.json biome.jsonc .golangci.yml .golangci.yaml ruff.toml .ruff.toml clippy.toml || true)
[ -z "$lint" ] && [ -f pyproject.toml ] && grep -qE '^\[tool\.ruff' pyproject.toml && lint="pyproject.toml [tool.ruff]"
if [ -n "$lint" ]; then row static lint present "$lint"; else row static lint missing; fi

# Import-boundary rules declared in a root configuration file, not mentioned anywhere in the tree.
boundary=$(first .dependency-cruiser.js .dependency-cruiser.cjs .dependency-cruiser.json .importlinter || true)
if [ -z "$boundary" ]; then
  for f in eslint.config.js eslint.config.mjs eslint.config.cjs eslint.config.ts .eslintrc.js .eslintrc.cjs .eslintrc.json .eslintrc.yml .eslintrc; do
    [ -f "$f" ] && grep -qE 'no-restricted-imports|import/no-restricted-paths|boundaries/' "$f" && { boundary="$f"; break; }
  done
fi
[ -z "$boundary" ] && [ -f pyproject.toml ] && grep -qE '^\[tool\.importlinter' pyproject.toml && boundary="pyproject.toml [tool.importlinter]"
[ -z "$boundary" ] && for f in .golangci.yml .golangci.yaml; do [ -f "$f" ] && grep -q depguard "$f" && boundary="$f"; done
if [ -n "$boundary" ]; then row static boundary-rules present "$boundary"; else row static boundary-rules missing; fi

ci=$(globfirst '.github/workflows/*.y*ml' || first .gitlab-ci.yml || true)
if [ -n "$ci" ]; then row static ci present "$ci"; else row static ci missing; fi

verify=$(globfirst '.agents/skills/verify-*/SKILL.md' || globfirst '.claude/skills/verify-*/SKILL.md' || true)
if [ -n "$verify" ]; then row verify verify-skill present "$verify"; else row verify verify-skill missing; fi

formal=$(globfirst '.agents/skills/formal-*/SKILL.md' || true)
[ -z "$formal" ] && formal=$(git grep -lE '"fast-check"|hypothesis' -- package.json pyproject.toml requirements*.txt 2>/dev/null | head -n 1 || true)
if [ -n "$formal" ]; then row verify properties present "$formal"; else row verify properties none "used only where examples cannot reach"; fi

# The rule table is the first Markdown table under `## Rules and enforcement`, and it counts only when its header is
# `| Rule | Enforced by |` followed by a delimiter row. Escaped pipes (`\|`) stay inside their cell, and the second
# cell is read whether or not a row ends with a pipe.
table=
[ -f AGENTS.md ] && table=$(awk '/^## /{inside=($0 ~ /^## Rules and enforcement[[:space:]]*$/); next} inside && /^\|/{print; seen=1; next} inside && seen{exit}' AGENTS.md)
if [ -n "$table" ]; then
  header=$(printf '%s\n' "$table" | sed -n 1p); delimiter=$(printf '%s\n' "$table" | sed -n 2p)
  [[ $header =~ ^\|[[:space:]]*Rule[[:space:]]*\|[[:space:]]*Enforced\ by[[:space:]]*\|[[:space:]]*$ && $delimiter =~ ^\|[[:space:]]*:?-+:?[[:space:]]*\|[[:space:]]*:?-+:?[[:space:]]*\|?[[:space:]]*$ ]] || table=
fi
unenforced=0
if [ ! -f AGENTS.md ]; then
  row prose rule-table missing "no AGENTS.md"
elif [ -z "$table" ]; then
  row prose rule-table missing "AGENTS.md has no | Rule | Enforced by | table under Rules and enforcement"
else
  unenforced=$(printf '%s\n' "$table" | sed 's/\\|/\x01/g' | awk -F'|' 'NR > 2 { cell = $3; gsub(/[`[:space:]]/, "", cell); if (cell ~ /^unenforced/) n++ } END { print n + 0 }')
  row prose rule-table present "AGENTS.md, $unenforced unenforced"
fi

if [ -n "$ci" ] && [ -n "$verify" ]; then row review full-send-ready yes "CI definition and verify skill present"; else row review full-send-ready no "full-send runs as full-stop here"; fi

next() { printf 'next\t%s\t%s\n' "$1" "$2"; exit 0; }
[ "$sources" -eq 0 ] && next repo-bootstrap "no source code yet: if the repository will hold code, install the default stack; a documentation-only repository needs only repo-init"
[ -n "$table" ] || next repo-init "write AGENTS.md and the Rules and enforcement table that records what is enforced today"
{ [ -z "$check" ] || [ -z "$ci" ]; } && next repo-bootstrap "existing repository: wire one check command and CI (the skill's existing-repository section)"
[ -z "$verify" ] && next verify-init "no verification skill: generate one so changes can be proven; full-send also requires it before it considers merging"
[ "$unenforced" -gt 0 ] && next correct "$unenforced unenforced rule(s): move the most frequent one to a check"
next none "the base is in place; use the event table in skills/harness-flow/SKILL.md"
