#!/usr/bin/env python3
# Adapted from tstack skills/babysit-pr/scripts/pr-wait (MIT, Copyright (c) 2026 Theo Browne) at 7de017b; GitLab backend added by Harness.
"""mr-wait: watch one GitHub pull request or GitLab merge request and print one
line per real event.

  mr-wait <target> [--repo PATH] [--host HOST] [--until green|ready|any-change] [--interval 20]

<target> is a number, #N, !N, a GitHub PR URL, or a GitLab MR URL on any host
(https://<host>/<group>/<sub>/<proj>/-/merge_requests/N). The provider comes
from the URL host, or else from `git remote get-url origin` in the current
directory: github.com is GitHub and any other host is GitLab. --repo overrides
the project path (owner/name or group/sub/proj) and --host the host. Stdout
carries only events, one line each prefixed #N (GitHub) or !N (GitLab), so a
monitor (Claude Code's Monitor tool) wakes the agent once per real event.
Progress and errors that do not end the run go to stderr.

--until
  green       GitHub: required checks passed on the current head (every CI
              check when the base branch requires none). GitLab: the head
              pipeline runs on the MR's head commit and succeeded
  ready       GitHub: green, Greptile or Macroscope reviewed the current head,
              and no review thread is unresolved. GitLab: green, blocking
              discussions resolved, no approval left, not a draft, and merge
              status mergeable (default)
  any-change  stop after the first poll that prints an event

Exit codes
  0  the --until condition is met, or the PR/MR merged
  1  the condition cannot be met without action: a required check or the head
     pipeline failed, the branch conflicts with its base, the PR/MR closed,
     `ready` is blocked by unresolved threads or a BEHIND/need_rebase branch,
     no GitLab pipeline reached the head within 15 minutes, or the forge
     stayed unreachable
  2  bad arguments, unknown PR/MR, or another mr-wait already watches it

GitHub events
  - a required check failed (name and link)
  - all checks finished on the head (one summary line)
  - a new comment, review, thread, or thread reply from someone other than the
    PR author or the gh user
  - Greptile, Macroscope, or CodeRabbit finished on the head, or a Greptile or
    Macroscope summary changed after that
  - the base branch moved and the new commits touch files in this PR
  - merge state became BEHIND or DIRTY
  - the PR merged or closed

GitLab events
  - the head pipeline failed or was canceled (failed job names and link)
  - the head pipeline finished (one summary line)
  - a new discussion, comment, or reply from someone other than the MR author
    or the glab user; system notes are skipped. A review bot's notes are
    ordinary events; the repository's bot-consumer skill interprets them
  - an approval was given or revoked
  - the target branch moved and the new commits touch files in this MR
  - merge status became need_rebase or conflict
  - the MR merged or closed

CodeRabbit is advisory: mr-wait reports it but never waits for it. Comment
edits are never events, and top-level GitHub comments from CI and deploy bots
(github-actions, Vercel) are skipped, because checks already carry that news.

State lives in $XDG_STATE_HOME/mr-wait/ (default ~/.local/state/mr-wait/). A
lock makes a second watcher for the same PR/MR exit at once. A state file lets
a restarted watcher report what arrived while no watcher ran. The first run for
a PR/MR records what already exists and reports only what comes after.
"""

from __future__ import annotations

import argparse
import fcntl
import hashlib
import html
import json
import os
import re
import subprocess
import sys
import time
import urllib.parse
from collections.abc import Sequence
from dataclasses import dataclass
from pathlib import Path
from typing import Any, NoReturn

GATING_BOTS = ("greptile", "macroscope")
ADVISORY_BOTS = ("coderabbit",)
# CI and deploy bots report through checks. Their PR comments are status reports.
STATUS_BOTS = ("github-actions", "vercel", "netlify", "railway", "cloudflare")


def default_state_dir() -> Path:
    xdg = os.environ.get("XDG_STATE_HOME", "")
    root = Path(xdg) if os.path.isabs(xdg) else Path.home() / ".local" / "state"
    return root / "mr-wait"


STATE_DIR = default_state_dir()
# A state file older than this describes an old session. Start a fresh baseline
# instead of replaying hours of comments as new events.
STALE_STATE_SECONDS = 6 * 3600
MAX_FAILED_POLLS = 10
TRANSIENT = re.compile(
    r"HTTP (5\d\d|429)|rate limit|timed? ?out|connection (reset|refused)|EOF|"
    r"temporar|could not resolve host|TLS handshake|Something went wrong|"
    r"\b5\d\d (Bad Gateway|Service Unavailable|Gateway Time-?out|Internal Server Error)",
    re.IGNORECASE,
)
FAILED = ("fail", "cancel")
# gh pr checks buckets, worst first. Duplicate names (push and pull_request runs
# of one job) collapse to the worst bucket.
RANK = {"fail": 4, "cancel": 3, "pending": 2, "pass": 1, "skipping": 0}

PIPELINE_FAILED = ("failed", "canceled")
PIPELINE_DONE = ("success", "failed", "canceled", "skipped")
# detailed_merge_status values that mean GitLab has not decided yet.
MERGE_UNKNOWN = ("", "unchecked", "checking", "preparing", "approvals_syncing")
NO_PIPELINE_SECONDS = 15 * 60
PER_PAGE = 100
MAX_PAGES = 50
# glab sends these environment tokens to whatever --hostname it is given, unlike
# its per-host stored logins. They are passed only to hosts the user vouched for.
ENV_TOKENS = ("GITLAB_TOKEN", "GITLAB_ACCESS_TOKEN", "OAUTH_TOKEN")
TOKEN_HOSTS: set[str] = set()

QUERY = """
query($owner: String!, $name: String!, $number: Int!) {
  viewer { login }
  repository(owner: $owner, name: $name) {
    pullRequest(number: $number) {
      url state headRefOid baseRefName mergeStateStatus
      author { login }
      baseRef { target { oid } }
      comments(last: 100) { nodes { id url body author { login __typename } } }
      reviews(last: 100) {
        nodes { id url state body commit { oid } author { login __typename } }
      }
      reviewThreads(last: 100) {
        nodes {
          isResolved path line
          comments(first: 100) { nodes { id url body author { login __typename } } }
        }
      }
    }
  }
}
"""

Json = dict[str, Any]


class CliError(Exception):
    def __init__(self, message: str, transient: bool) -> None:
        super().__init__(message)
        self.transient = transient


@dataclass(frozen=True)
class Target:
    provider: str  # "github" or "gitlab"
    host: str
    project: str
    number: int


def log(message: str) -> None:
    print(f"mr-wait: {message}", file=sys.stderr, flush=True)


def fail(message: str, code: int = 2) -> NoReturn:
    # Fatal messages go to stdout so a monitor shows the agent why it stopped.
    print(f"mr-wait: {message}", flush=True)
    sys.exit(code)


def run_cli(argv: list[str], env: dict[str, str] | None = None) -> subprocess.CompletedProcess[str]:
    """The only process boundary. Tests replace it with a fake gh, glab, and git."""
    return subprocess.run(argv, capture_output=True, text=True, env=env)


def cli(
    argv: list[str], allow: tuple[int, ...] = (0,), env: dict[str, str] | None = None
) -> subprocess.CompletedProcess[str]:
    """Run gh or glab. Retries transient failures (HTTP 5xx or 429, network) with backoff."""
    delay = 2
    for attempt in range(5):
        try:
            proc = run_cli(argv, env)
        except FileNotFoundError:
            raise CliError(f"{argv[0]} is not installed", False) from None
        transient = proc.returncode != 0 and bool(TRANSIENT.search(proc.stderr))
        if not transient and proc.returncode in allow:
            return proc
        lines = proc.stderr.strip().splitlines()
        message = lines[-1] if lines else f"{argv[0]} exited {proc.returncode}"
        if not transient or attempt == 4:
            raise CliError(message, transient)
        log(f"{' '.join(argv[:3])}: {message}; retry in {delay}s")
        time.sleep(delay)
        delay *= 2
    raise AssertionError("unreachable")


def gh(args: list[str], allow: tuple[int, ...] = (0,)) -> subprocess.CompletedProcess[str]:
    return cli(["gh", *args], allow)


def gh_lines(args: list[str]) -> list[str]:
    return [line for line in gh(args).stdout.splitlines() if line]


def glab(host: str, path: str) -> Any:
    env = None if host in TOKEN_HOSTS else {k: v for k, v in os.environ.items() if k not in ENV_TOKENS}
    return json.loads(cli(["glab", "api", "--hostname", host, path], env=env).stdout)


def bot_name(text: str | None) -> str | None:
    """Which review bot a login or check name belongs to, if any."""
    lowered = (text or "").lower()
    return next((bot for bot in GATING_BOTS + ADVISORY_BOTS if bot in lowered), None)


def who(node: Json) -> tuple[str, bool]:
    author = node.get("author") or {}
    return author.get("login") or "ghost", author.get("__typename") == "Bot"


def plain(body: str) -> str:
    body = re.sub(r"<!--.*?-->", " ", body or "", flags=re.DOTALL)
    return html.unescape(re.sub(r"<[^>]+>", " ", body))


def snippet(body: str, limit: int = 100) -> str:
    text = re.sub(r"\s+", " ", plain(body)).strip()
    return text if len(text) <= limit else text[: limit - 3] + "..."


def verdict(body: str) -> str:
    """The verdict line of a bot summary (Macroscope, Greptile), if it has one."""
    for line in plain(body).splitlines():
        if re.search(r"verdict|confidence score", line, re.IGNORECASE):
            return snippet(line.replace("*", ""), 80)
    return ""


def digest(body: str) -> str:
    return hashlib.sha1(re.sub(r"\s+", " ", plain(body)).encode()).hexdigest()[:12]


def parse_remote(url: str) -> tuple[str, str] | None:
    """(host, project path) of a git remote. An SSH port is dropped: the API host is the hostname."""
    url = url.strip()
    if "://" in url:
        parts = urllib.parse.urlsplit(url)
        host = parts.hostname if parts.scheme == "ssh" else parts.netloc.rpartition("@")[2]
        path = parts.path
    else:
        scp = re.fullmatch(r"(?:[^@/\s]+@)?([^:/\s]+):(\S+)", url)
        if not scp:
            return None
        host, path = scp.groups()
    path = re.sub(r"\.git$", "", path.strip("/"))
    if not host or not path:
        return None
    return host.lower(), path


def origin() -> tuple[str, str] | None:
    try:
        proc = run_cli(["git", "remote", "get-url", "origin"])
    except FileNotFoundError:
        return None
    return parse_remote(proc.stdout) if proc.returncode == 0 else None


def project_api(project: str) -> str:
    return "projects/" + urllib.parse.quote(project, safe="")


def parse_target(raw: str | None, repo: str | None, host: str | None = None) -> Target:
    if raw is None or not raw.strip():
        fail("missing PR/MR number. Did a variable expand to nothing? Usage: mr-wait <target> [--repo PATH]")
    raw = raw.strip()
    explicit = host
    remote = None
    github = re.fullmatch(r"https?://github\.com/([^/\s]+/[^/\s]+)/pull/(\d+)(?:[/?#]\S*)?", raw)
    gitlab = re.fullmatch(r"https?://([^/\s]+)/(\S+?)/-/merge_requests/(\d+)(?:[/?#]\S*)?", raw)
    number = re.fullmatch(r"[#!]?(\d+)", raw)
    if github:
        host = host or "github.com"
        repo = repo or github.group(1)
        num = int(github.group(2))
    elif gitlab:
        host = host or gitlab.group(1).rpartition("@")[2].lower()
        repo = repo or gitlab.group(2)
        num = int(gitlab.group(3))
    elif number:
        num = int(number.group(1))
        remote = origin()
        host = host or (remote[0] if remote else "github.com")
        if not repo and remote and remote[0] == host and host != "github.com":
            repo = remote[1]
    else:
        fail(f"'{raw}' is not a PR/MR number or URL")
    if num <= 0:
        fail(f"'{raw}' is not a valid PR/MR number")

    if host == "github.com":
        if not repo:
            try:
                repo = gh(["repo", "view", "--json", "nameWithOwner", "--jq", ".nameWithOwner"]).stdout.strip()
            except CliError as error:
                fail(f"no --repo given and the current directory has no GitHub repo ({error})")
        if not re.fullmatch(r"[\w.-]+/[\w.-]+", repo):
            fail(f"'{repo}' is not owner/name")
        try:
            gh(["pr", "view", str(num), "-R", repo, "--json", "number"])
        except CliError as error:
            if not error.transient:  # a transient failure is retried by the poll loop
                fail(f"cannot read {repo}#{num}: {error}")
        return Target("github", host, repo, num)

    # A URL may come from anywhere; its host gets environment tokens only when it
    # is the checkout's own forge or the user named it with --host.
    remote = remote or origin()
    if explicit or (remote and remote[0] == host):
        TOKEN_HOSTS.add(host)
    if not repo:
        fail(f"no --repo given and origin in the current directory is not a project on {host}")
    if not re.fullmatch(r"[\w.-]+(/[\w.-]+)+", repo):
        fail(f"'{repo}' is not a GitLab project path like group/sub/proj")
    try:
        glab(host, f"{project_api(repo)}/merge_requests/{num}")
    except CliError as error:
        if not error.transient:
            fail(f"cannot read {host}/{repo}!{num}: {error}")
    return Target("gitlab", host, repo, num)


def state_key(target: Target) -> str:
    host = re.sub(r"[^\w.-]", "_", target.host)
    return f"{target.provider}__{host}__{target.project.replace('/', '__')}__{target.number}"


def lock(target: Target) -> Any:
    """Hold a per-PR/MR lock for the life of the process. The OS drops it on exit."""
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    handle = open(STATE_DIR / f"{state_key(target)}.lock", "a+")
    try:
        fcntl.flock(handle, fcntl.LOCK_EX | fcntl.LOCK_NB)
    except BlockingIOError:
        handle.seek(0)
        pid = handle.read().strip() or "unknown"
        mark = "#" if target.provider == "github" else "!"
        fail(
            f"pid {pid} already watches {target.project}{mark}{target.number}, so this watcher exits to avoid "
            f"duplicate events. If no events reach you from it, run `kill {pid}` and start again."
        )
    handle.seek(0)
    handle.truncate()
    handle.write(str(os.getpid()))
    handle.flush()
    return handle


def required_checks(repo: str, base: str) -> set[str]:
    """Required check names for the base branch, from rulesets and classic branch
    protection. Knowing them up front means a required check that has not started
    yet counts as pending, instead of green by omission."""
    sources = (
        (
            f"repos/{repo}/rules/branches/{base}",
            '.[] | select(.type == "required_status_checks") | .parameters.required_status_checks[].context',
        ),
        (f"repos/{repo}/branches/{base}/protection/required_status_checks", ".contexts[]?, .checks[]?.context"),
    )
    names: set[str] = set()
    for path, jq in sources:
        try:
            names.update(gh_lines(["api", path, "--jq", jq]))
        except CliError as error:
            if "HTTP 404" not in str(error):  # 404 means no protection, which is normal
                log(f"could not read required checks from {path}: {error}")
    return names


class Watcher:
    """Provider-neutral state, dedupe, and poll loop. Subclasses implement poll()."""

    forge = ""
    mark = ""

    def __init__(self, target: Target, until: str, interval: int) -> None:
        self.target, self.until, self.interval = target, until, interval
        self.number = target.number
        self.path = STATE_DIR / f"{state_key(target)}.json"
        state = self.load()
        # First run for this PR/MR: record what exists and report nothing.
        self.baseline = state is None
        self.state: Json = {**self.initial_state(), **(state or {})}
        self.reported: set[str] = set(self.state["reported"])
        self.printed: set[str] = set()
        self.events = 0

    @property
    def name(self) -> str:
        return f"{self.target.project}{self.mark}{self.number}"

    def initial_state(self) -> Json:
        return {"reported": [], "base_oid": None, "merge_state": None}

    def load(self) -> Json | None:
        try:
            if time.time() - self.path.stat().st_mtime > STALE_STATE_SECONDS:
                return None
            return json.loads(self.path.read_text())
        except (OSError, ValueError):
            return None

    def save(self) -> None:
        self.state["reported"] = sorted(self.reported)
        self.path.parent.mkdir(parents=True, exist_ok=True)
        tmp = self.path.with_suffix(".tmp")
        tmp.write_text(json.dumps(self.state))
        tmp.replace(self.path)

    def say(self, line: str) -> None:
        if line not in self.printed:
            self.printed.add(line)
            print(f"{self.mark}{self.number} {line}", flush=True)

    def emit(self, key: str, line: str) -> None:
        """Print an event once per PR/MR, across restarts."""
        if key in self.reported:
            return
        self.reported.add(key)
        if not self.baseline:
            self.events += 1
            self.say(line)

    def change(self, line: str) -> None:
        """Print an event found by diffing saved state, which already dedupes it."""
        if not self.baseline:
            self.events += 1
            self.say(line)

    def finish(self, code: int, lines: Sequence[str] = ()) -> NoReturn:
        for line in lines:
            self.say(line)
        self.save()
        sys.exit(code)

    def poll(self) -> None:
        raise NotImplementedError

    def settle(self) -> None:
        """Persist a successful poll and end the baseline."""
        self.save()
        if self.baseline:
            log(f"baseline recorded for {self.name}; reporting only new events")
        self.baseline = False

    def run(self) -> NoReturn:
        failures = 0
        while True:
            try:
                self.poll()
                failures = 0
            except CliError as error:
                if not error.transient:
                    self.finish(1, [f"mr-wait stopped: {error}"])
                failures += 1
                log(f"poll failed ({failures}/{MAX_FAILED_POLLS}): {error}")
                if failures >= MAX_FAILED_POLLS:
                    self.finish(1, [f"mr-wait stopped: {self.forge} unreachable for {failures} polls: {error}"])
            else:
                self.settle()
            time.sleep(self.interval)


class GitHubWatcher(Watcher):
    forge = "GitHub"
    mark = "#"

    def __init__(self, target: Target, until: str, interval: int) -> None:
        super().__init__(target, until, interval)
        self.repo, self.pr = target.project, target.number
        self.owner, self.repo_name = self.repo.split("/")
        self.required: set[str] | None = None
        self.prev_snapshot: list[tuple[str, str]] | None = None
        self.pr_files: dict[str, set[str]] = {}

    def initial_state(self) -> Json:
        return {**super().initial_state(), "summaries": {}}

    def fetch_pr(self) -> Json:
        proc = gh([
            "api", "graphql", "-f", f"query={QUERY}",
            "-f", f"owner={self.owner}", "-f", f"name={self.repo_name}", "-F", f"number={self.pr}",
        ])
        data = json.loads(proc.stdout)["data"]
        pr = data["repository"]["pullRequest"]
        pr["viewer"] = data["viewer"]["login"]
        return pr

    def fetch_checks(self) -> dict[str, Json]:
        # gh pr checks exits 8 while checks are pending and 1 when one failed.
        # Those are states, not errors: read the JSON and ignore the exit code.
        proc = gh(["pr", "checks", str(self.pr), "-R", self.repo, "--json", "name,bucket,link,description"], allow=(0, 1, 8))
        if not proc.stdout.strip():
            if "no checks reported" in proc.stderr:
                return {}
            raise CliError(proc.stderr.strip() or f"gh pr checks exited {proc.returncode}", False)
        checks: dict[str, Json] = {}
        for row in json.loads(proc.stdout):
            current = checks.get(row["name"])
            if current is None or RANK.get(row["bucket"], 2) > RANK.get(current["bucket"], 2):
                checks[row["name"]] = row
        return checks

    def base_overlap(self, head: str, old: str, new: str) -> list[str]:
        """Files this PR touches that the new base commits also touch."""
        try:
            if head not in self.pr_files:
                self.pr_files[head] = set(gh_lines(["pr", "diff", str(self.pr), "-R", self.repo, "--name-only"]))
            moved = gh_lines(["api", f"repos/{self.repo}/compare/{old}...{new}", "--jq", ".files[].filename"])
        except CliError as error:
            log(f"could not compare base commits: {error}")
            return []
        return sorted(self.pr_files[head].intersection(moved))

    def behind(self, base: str, base_oid: str | None, head: str) -> str:
        """How far the head is behind its base, for the green and ready lines."""
        if not base_oid:
            return ""
        try:
            count = gh(["api", f"repos/{self.repo}/compare/{base_oid}...{head}", "--jq", ".behind_by"]).stdout.strip()
        except CliError:
            return ""
        return f"; {count} commit{'' if count == '1' else 's'} behind {base}"

    def poll(self) -> None:
        pr = self.fetch_pr()
        if pr["state"] == "MERGED":
            self.finish(0, [f"merged: {pr['url']}"])
        if pr["state"] == "CLOSED":
            self.finish(1, [f"closed without merging: {pr['url']}"])

        base = pr["baseRefName"]
        if self.required is None:
            self.required = required_checks(self.repo, base)
            gate = ", ".join(sorted(self.required)) or "none set, so every CI check gates"
            log(f"watching {self.repo}#{self.pr} until {self.until}; required checks: {gate}")
        checks = self.fetch_checks()
        head = pr["headRefOid"]
        short = head[:7]
        mine = {who(pr)[0], pr["viewer"]}
        comments = pr["comments"]["nodes"]
        reviews = pr["reviews"]["nodes"]
        threads = pr["reviewThreads"]["nodes"]
        self.events = 0

        # Required checks. With no required checks configured, every CI check
        # gates except the review bots' own checks.
        gate = self.required or {name for name in checks if not bot_name(name)}
        label = "required check" if self.required else "check"

        def bucket(name: str) -> str:
            return checks[name]["bucket"] if name in checks else "pending"

        fail_lines: list[str] = []
        for name in sorted(gate):
            if bucket(name) in FAILED:
                link = checks[name]["link"]
                fail_lines.append(f"{label} failed: {name} {link}")
                self.emit(f"fail:{head}:{name}:{link}", fail_lines[-1])
        watched = {name: c for name, c in checks.items() if bot_name(name) not in ADVISORY_BOTS}
        gate_done = bool(gate) and all(bucket(n) != "pending" for n in gate)
        all_done = gate_done and all(c["bucket"] != "pending" for c in watched.values())
        # Checks appear a few seconds after a push. Two identical polls in a row
        # guard against calling a half-registered set of checks finished.
        snapshot = sorted((name, c["bucket"]) for name, c in watched.items())
        stable = snapshot == self.prev_snapshot
        self.prev_snapshot = snapshot
        green = gate_done and stable and not fail_lines

        # People and bots talking. Edits are never events.
        for comment in comments:
            login, is_bot = who(comment)
            if login in mine or bot_name(login) or (is_bot and any(b in login for b in STATUS_BOTS)):
                continue
            self.emit(f"c:{comment['id']}", f"comment from {login}: {snippet(comment['body'])} {comment['url']}")
        for review in reviews:
            login, is_bot = who(review)
            if login in mine or is_bot:
                continue
            if review["state"] in ("APPROVED", "CHANGES_REQUESTED") or review["body"].strip():
                state = review["state"].lower().replace("_", " ")
                self.emit(f"c:{review['id']}", f"review from {login} ({state}): {snippet(review['body'])} {review['url']}")
        unresolved: list[str] = []
        for thread in threads:
            nodes = thread["comments"]["nodes"]
            if not thread["isResolved"] and nodes:
                unresolved.append(nodes[0]["url"])
            where = f"{thread['path']}:{thread['line']}" if thread["line"] else thread["path"]
            for index, comment in enumerate(nodes):
                login, _ = who(comment)
                if login in mine:
                    continue
                kind = "new thread" if index == 0 else "thread reply"
                self.emit(f"c:{comment['id']}", f"{kind} from {login} on {where}: {snippet(comment['body'])} {comment['url']}")

        # Review bots on the current head. A bot with checks is done when they
        # finish. Otherwise it is done once it reviews the head commit or its
        # summary names the head.
        bot_status: dict[str, str] = {}
        reviewed: list[str] = []
        for bot in GATING_BOTS + ADVISORY_BOTS:
            own_checks = {name: c for name, c in checks.items() if bot_name(name) == bot}
            summaries = [c for c in comments if bot_name(who(c)[0]) == bot]
            own_reviews = [r for r in reviews if bot_name(who(r)[0]) == bot]
            on_head = any((r.get("commit") or {}).get("oid") == head for r in own_reviews)
            if own_checks:
                done = all(c["bucket"] != "pending" for c in own_checks.values())
            else:
                done = on_head or any(short in s["body"] for s in summaries)
            seen = bool(own_checks or summaries or own_reviews)
            if bot in ADVISORY_BOTS and own_checks:
                desc = next(iter(own_checks.values()))
                bot_status[bot] = f"{bot} {desc['description'] or desc['bucket']} (advisory)"
            elif seen:
                bot_status[bot] = f"{bot} {'done' if done else 'pending'}{' (advisory)' if bot in ADVISORY_BOTS else ''}"
            key = f"bot:{bot}:{head}"
            was_done = key in self.reported
            if done:
                if bot in GATING_BOTS:
                    reviewed.append(bot)
                failed = [name for name, c in own_checks.items() if c["bucket"] in FAILED]
                detail = "; ".join(filter(None, [
                    next((v for v in map(verdict, (s["body"] for s in summaries)) if v), ""),
                    f"failed: {', '.join(failed)}" if failed else "",
                ]))
                tag = " (advisory, not waited on)" if bot in ADVISORY_BOTS else ""
                self.emit(key, f"{bot} finished on {short}{': ' + detail if detail else ''}{tag}")
            if bot in GATING_BOTS:
                for s in summaries:
                    new, old = digest(s["body"]), self.state["summaries"].get(s["id"])
                    self.state["summaries"][s["id"]] = new
                    if was_done and old and old != new:
                        text = verdict(s["body"]) or snippet(s["body"])
                        self.emit(f"summary:{s['id']}:{new}", f"{bot} summary changed on {short}: {text} {s['url']}")

        # Base branch and merge state.
        base_oid = ((pr.get("baseRef") or {}).get("target") or {}).get("oid")
        old_base = self.state["base_oid"]
        if base_oid and old_base and base_oid != old_base and not self.baseline:
            touched = self.base_overlap(head, old_base, base_oid)
            if touched:
                more = f" and {len(touched) - 5} more" if len(touched) > 5 else ""
                self.emit(
                    f"base:{base_oid}",
                    f"{base} moved to {base_oid[:7]} and touches files in this PR: {', '.join(touched[:5])}{more}",
                )
        if base_oid:
            self.state["base_oid"] = base_oid
        merge_state = pr["mergeStateStatus"]
        dirty_line = f"merge state is DIRTY: the branch conflicts with {base}, rebase it"
        behind_line = f"merge state is BEHIND: update the branch from {base} before merging"
        if merge_state != "UNKNOWN":
            if merge_state in ("BEHIND", "DIRTY") and self.state["merge_state"] != merge_state:
                line = dirty_line if merge_state == "DIRTY" else behind_line
                self.emit(f"merge:{merge_state}:{head}:{base_oid}", line)
            self.state["merge_state"] = merge_state

        # One summary line per head once all checks finish.
        counts: dict[str, int] = {}
        for c in watched.values():
            counts[c["bucket"]] = counts.get(c["bucket"], 0) + 1
        failed_names = sorted(name for name, c in watched.items() if c["bucket"] in FAILED)
        parts = [
            ", ".join(f"{n} {b}" for b, n in sorted(counts.items()))
            + (f" ({', '.join(failed_names)})" if failed_names else ""),
            f"required {sum(bucket(n) in ('pass', 'skipping') for n in self.required)}/{len(self.required)} green"
            if self.required
            else "",
            ", ".join(bot_status[b] for b in GATING_BOTS + ADVISORY_BOTS if b in bot_status)
            or "no Greptile or Macroscope yet",
            f"{len(unresolved)} unresolved threads",
            f"merge state {merge_state}",
        ]
        summary = "; ".join(p for p in parts if p)
        checks_key = f"checks:{head}"

        # Decide whether to stop. A green or ready line carries the same summary
        # as the checks line, so it marks that event as reported.
        if self.until != "any-change":
            if merge_state == "DIRTY":
                self.finish(1, [dirty_line])
            if fail_lines:
                self.finish(1, fail_lines)
            if green and self.until == "green":
                self.reported.add(checks_key)
                self.finish(0, [f"green on {short}: {summary}{self.behind(base, base_oid, head)}"])
            # ready waits for Greptile or Macroscope, never for CodeRabbit.
            if green and reviewed:
                if unresolved:
                    self.finish(1, [f"blocked by {len(unresolved)} unresolved threads on {short}: {' '.join(unresolved)}"])
                if merge_state == "BEHIND":
                    self.finish(1, [behind_line])
                self.reported.add(checks_key)
                self.finish(0, [f"ready on {short}: {summary}{self.behind(base, base_oid, head)}"])
        if all_done and (stable or self.baseline):
            self.emit(checks_key, f"checks finished on {short}: {summary}")
        if self.until == "any-change" and self.events:
            self.finish(0)


class GitLabWatcher(Watcher):
    forge = "GitLab"
    mark = "!"

    def __init__(self, target: Target, until: str, interval: int) -> None:
        super().__init__(target, until, interval)
        self.host = target.host
        self.project = project_api(target.project)
        self.mr_path = f"{self.project}/merge_requests/{target.number}"
        self.viewer: str | None = None
        self.prev_snapshot: tuple[Any, ...] | None = None
        self.parents: dict[str, list[str]] = {}
        # (head sha, monotonic time) since the head has had no pipeline.
        self.waiting: tuple[str, float] | None = None
        self.failed_jobs: dict[int, list[str]] = {}
        self.mr_files: dict[str, set[str]] = {}

    def initial_state(self) -> Json:
        return {**super().initial_state(), "approvers": None}

    def merge_parents(self, sha: str | None) -> list[str]:
        """Parent commits of a merged-results pipeline's merge commit (cached; a commit never changes)."""
        if not sha:
            return []
        if sha not in self.parents:
            commit = self.api(f"{self.project}/repository/commits/{sha}")
            self.parents[sha] = list(commit.get("parent_ids") or [])
        return self.parents[sha]

    def api(self, path: str) -> Any:
        return glab(self.host, path)

    def pages(self, path: str) -> list[Json]:
        """Every item of a paginated list. `path` already carries per_page."""
        items: list[Json] = []
        for page in range(1, MAX_PAGES + 1):
            batch = self.api(f"{path}&page={page}")
            items.extend(batch)
            if len(batch) < PER_PAGE:
                break
        return items

    def jobs_failed(self, pipeline_id: int) -> list[str]:
        if pipeline_id not in self.failed_jobs:
            jobs = self.pages(f"{self.project}/pipelines/{pipeline_id}/jobs?per_page={PER_PAGE}")
            self.failed_jobs[pipeline_id] = sorted({
                job["name"] for job in jobs if job.get("status") == "failed" and not job.get("allow_failure")
            })
        return self.failed_jobs[pipeline_id]

    def base_overlap(self, head: str, old: str, new: str) -> list[str]:
        """Files this MR touches that the new target branch commits also touch."""
        try:
            if head not in self.mr_files:
                diffs = self.pages(f"{self.mr_path}/diffs?per_page={PER_PAGE}")
                self.mr_files[head] = {p for d in diffs for p in (d.get("new_path"), d.get("old_path")) if p}
            compare = self.api(f"{self.project}/repository/compare?from={old}&to={new}")
        except CliError as error:
            log(f"could not compare target branch commits: {error}")
            return []
        moved = {p for d in compare.get("diffs") or [] for p in (d.get("new_path"), d.get("old_path")) if p}
        return sorted(self.mr_files[head] & moved)

    def behind(self, target: str, base_oid: str | None, head: str) -> str:
        """How far the head is behind its target branch, for the green and ready lines."""
        if not base_oid:
            return ""
        try:
            count = len(self.api(f"{self.project}/repository/compare?from={head}&to={base_oid}").get("commits") or [])
        except CliError:
            return ""
        return f"; {count} commit{'' if count == 1 else 's'} behind {target}"

    def target_oid(self, branch: str) -> str | None:
        try:
            ref = self.api(f"{self.project}/repository/branches/{urllib.parse.quote(branch, safe='')}")
        except CliError as error:
            log(f"could not read target branch {branch}: {error}")
            return None
        return (ref.get("commit") or {}).get("id")

    def poll(self) -> None:
        mr = self.api(self.mr_path)
        url = mr.get("web_url") or ""
        if mr["state"] == "merged":
            self.finish(0, [f"merged: {url}"])
        if mr["state"] == "closed":
            self.finish(1, [f"closed without merging: {url}"])

        if self.viewer is None:
            self.viewer = self.api("user").get("username") or ""
            log(f"watching {self.target.host}/{self.name} until {self.until}")
        discussions = self.pages(f"{self.mr_path}/discussions?per_page={PER_PAGE}")
        approvals = self.api(f"{self.mr_path}/approvals")
        head = mr["sha"]
        short = head[:7]
        target = mr["target_branch"]
        mine = {(mr.get("author") or {}).get("username"), self.viewer}
        draft = bool(mr.get("draft") or mr.get("work_in_progress"))
        self.events = 0

        # The head pipeline counts when it ran on the MR's head commit, or on the merge ref GitLab builds for
        # merged-results pipelines when that temporary merge commit has the current head as a parent. The merge
        # ref name is the same across pushes, so the parent check keeps an older head's pipeline from counting.
        pipeline = mr.get("head_pipeline") or {}
        merge_ref = f"refs/merge-requests/{mr.get('iid')}/merge"
        on_head = bool(pipeline) and (
            pipeline.get("sha") == head
            or (pipeline.get("ref") == merge_ref and head in self.merge_parents(pipeline.get("sha")))
        )
        status = pipeline.get("status") if on_head else None
        fail_lines: list[str] = []
        if status in PIPELINE_FAILED:
            names = ", ".join(self.jobs_failed(pipeline["id"])) or "no failed jobs listed"
            fail_lines.append(f"pipeline {status} on {short}: {names} {pipeline.get('web_url') or ''}".rstrip())
            self.emit(f"fail:{head}:{pipeline['id']}", fail_lines[-1])
        # A pipeline status can flip right after a push or retry. Two identical
        # polls in a row guard against calling a passing pipeline finished.
        snapshot = (head, pipeline.get("id"), pipeline.get("sha"), pipeline.get("status"))
        stable = snapshot == self.prev_snapshot
        self.prev_snapshot = snapshot
        done = status in PIPELINE_DONE
        green = status == "success" and stable
        now = time.monotonic()
        if on_head:
            self.waiting = None
        elif self.waiting is None or self.waiting[0] != head:
            self.waiting = (head, now)
        stalled = self.waiting is not None and now - self.waiting[1] >= NO_PIPELINE_SECONDS

        # People and bots talking. Edits and system notes are never events.
        unresolved: list[str] = []
        for discussion in discussions:
            notes = discussion.get("notes") or []
            if not notes:
                continue
            if any(n.get("resolvable") and not n.get("resolved") for n in notes):
                unresolved.append(f"{url}#note_{notes[0]['id']}")
            first_position = notes[0].get("position") or {}
            for index, note in enumerate(notes):
                user = (note.get("author") or {}).get("username") or "ghost"
                if note.get("system") or user in mine:
                    continue
                link = f"{url}#note_{note['id']}"
                text = snippet(note.get("body") or "")
                position = note.get("position") or first_position
                path = position.get("new_path") or position.get("old_path")
                line = position.get("new_line") or position.get("old_line")
                where = f" on {path}:{line}" if path and line else f" on {path}" if path else ""
                if index > 0:
                    kind = "thread reply"
                elif discussion.get("individual_note"):
                    kind, where = "comment", ""
                else:
                    kind = "new thread"
                self.emit(f"n:{note['id']}", f"{kind} from {user}{where}: {text} {link}")

        # Approvals, by diffing the saved approver set.
        approvers = sorted({
            (a.get("user") or {}).get("username") for a in approvals.get("approved_by") or []
        } - {None})
        previous = self.state["approvers"]
        if previous is not None:
            for user in sorted(set(approvers) - set(previous) - mine):
                self.change(f"approval given by {user}")
            for user in sorted(set(previous) - set(approvers) - mine):
                self.change(f"approval revoked by {user}")
        self.state["approvers"] = approvers
        approvals_left = approvals.get("approvals_left") or 0
        required = approvals.get("approvals_required")
        required = len(approvers) + approvals_left if required is None else required

        # Target branch and merge status.
        base_oid = self.target_oid(target)
        old_base = self.state["base_oid"]
        if base_oid and old_base and base_oid != old_base and not self.baseline:
            touched = self.base_overlap(head, old_base, base_oid)
            if touched:
                more = f" and {len(touched) - 5} more" if len(touched) > 5 else ""
                self.emit(
                    f"base:{base_oid}",
                    f"{target} moved to {base_oid[:7]} and touches files in this MR: {', '.join(touched[:5])}{more}",
                )
        if base_oid:
            self.state["base_oid"] = base_oid
        merge_status = mr.get("detailed_merge_status") or ""
        conflict = merge_status == "conflict" or bool(mr.get("has_conflicts"))
        merge_state = "conflict" if conflict else merge_status
        dirty_line = f"merge status is conflict: the branch conflicts with {target}, rebase it"
        behind_line = f"merge status is need_rebase: rebase the branch onto {target} before merging"
        if merge_state not in MERGE_UNKNOWN:
            if merge_state in ("need_rebase", "conflict") and self.state["merge_state"] != merge_state:
                self.emit(f"merge:{merge_state}:{head}:{base_oid}", dirty_line if conflict else behind_line)
            self.state["merge_state"] = merge_state

        # One summary line per head pipeline once it finishes.
        parts = [
            f"pipeline {status}" if on_head else "no pipeline on head",
            f"approvals {len(approvers)}/{required}",
            f"{len(unresolved)} unresolved discussions",
            "draft" if draft else "",
            f"merge status {merge_status or 'unknown'}",
        ]
        summary = "; ".join(p for p in parts if p)
        pipeline_key = f"pipeline:{head}:{pipeline.get('id')}"

        # Decide whether to stop. A green or ready line carries the same summary
        # as the pipeline line, so it marks that event as reported.
        if self.until != "any-change":
            if conflict:
                self.finish(1, [dirty_line])
            if fail_lines:
                self.finish(1, fail_lines)
            if stalled:
                self.finish(1, [f"no pipeline on {short} after {NO_PIPELINE_SECONDS // 60}m"])
            if green and self.until == "green":
                self.reported.add(pipeline_key)
                self.finish(0, [f"green on {short}: {summary}{self.behind(target, base_oid, head)}"])
            if green:
                if not mr.get("blocking_discussions_resolved", True):
                    self.finish(1, [f"blocked by {len(unresolved)} unresolved discussions on {short}: {' '.join(unresolved)}".rstrip()])
                if merge_state == "need_rebase":
                    self.finish(1, [behind_line])
                if approvals_left == 0 and not draft and merge_status == "mergeable":
                    self.reported.add(pipeline_key)
                    self.finish(0, [f"ready on {short}: {summary}{self.behind(target, base_oid, head)}"])
        if done and (stable or self.baseline):
            self.emit(pipeline_key, f"pipeline finished on {short}: {summary}")
        if self.until == "any-change" and self.events:
            self.finish(0)


def main() -> None:
    parser = argparse.ArgumentParser(
        prog="mr-wait", description="Watch a GitHub PR or GitLab MR and print one line per real event."
    )
    parser.add_argument("target", nargs="?", help="number, #N, !N, PR URL, or MR URL")
    parser.add_argument("--repo", help="owner/name or group/sub/proj (default: from the URL or the current checkout)")
    parser.add_argument("--host", help="forge host (default: from the URL or the origin remote)")
    parser.add_argument("--until", choices=("green", "ready", "any-change"), default="ready")
    parser.add_argument("--interval", type=int, default=20, help="seconds between polls (default 20, min 5)")
    args = parser.parse_args()
    target = parse_target(args.target, args.repo, args.host)
    _lock = lock(target)
    watcher = GitHubWatcher if target.provider == "github" else GitLabWatcher
    watcher(target, args.until, max(args.interval, 5)).run()


if __name__ == "__main__":
    try:
        main()
    except KeyboardInterrupt:
        sys.exit(130)
